rules_version = '2';

// Every collection lives under users/{userId}. A request can only read or
// write data under its own uid — enforced here, not in client JS, so the
// rule holds even if the frontend code has a bug or is bypassed entirely.
//
// The project owner's Firebase Console / Admin SDK access is separate from
// these rules (Console/Admin access bypasses client-side rules by design).
// That's why the in-app privacy copy says "your journal is private," not
// "nobody but you can access this" — see README's Privacy section.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /journal/{entryId} {
        allow read, write: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /focusSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /dailyPlans/{date} {
        allow read, write: if isOwner(userId);
      }

      match /reflections/{date} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Push-notification device tokens. Doc id is the FCM token itself.
      // Only the owning client reads/writes these; the Cloud Function that
      // actually sends pushes uses the Admin SDK, which bypasses these
      // rules entirely (see functions/index.js).
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
